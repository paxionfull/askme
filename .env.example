LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# Cursor SDK（未知站点数据源接入；也可在设置页配置，勿把真实 Key 提交到仓库）
CURSOR_API_KEY=

# 知乎数据源需要（从浏览器复制 Cookie；也可在设置页配置）
# ZHIHU_COOKIE=

# 微信公众号列表需要公众号后台凭证（设置页「微信」；Cookie 须含 askme_mp_token 与 slave_sid）
# ASKME_COOKIE_WEIXIN=
# WEIXIN_MP_TOKEN=

# 数据源抓取限速（可选）
# FEED_PAGE_DELAY=1.2          # 列表翻页间隔秒数
# FEED_REFRESH_CONCURRENCY=8   # 批量更新并发数
# FEED_REFRESH_TIMEOUT=30      # 单个源刷新超时秒数（超时跳过，避免整批卡住）
# BODY_FETCH_CONCURRENCY=4     # 正文并发拉取数（过大易触发 429）
