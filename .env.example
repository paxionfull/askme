LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# Cursor SDK（未知站点数据源接入；也可在设置页配置，勿把真实 Key 提交到仓库）
CURSOR_API_KEY=

# 需登录的数据源 Cookie（也可在设置页「数据源授权」配置）
# ASKME_COOKIE_<SLOT>=
# 兼容旧变量示例：
# ZHIHU_COOKIE=

# 数据源抓取限速（可选）
# FEED_PAGE_DELAY=1.2          # 列表翻页间隔秒数
# FEED_REFRESH_CONCURRENCY=8   # 批量更新并发数
# FEED_REFRESH_TIMEOUT=30      # 单个源刷新超时秒数（超时跳过，避免整批卡住）
# BODY_FETCH_CONCURRENCY=4     # 正文并发拉取数（过大易触发 429）

# 本地数据保留（文章元数据 / 正文 / RAG 索引 / 简报缓存 / 接入日志）
# DATA_RETENTION_DAYS=3        # 保留近 N 个上海自然日（默认 3）
# DATA_RETENTION_HOUR=4        # 每日清理时刻（Asia/Shanghai）
# DATA_RETENTION_MINUTE=0
# DATA_RETENTION_VACUUM=       # 空=删≥200 行才 VACUUM；1=有删除就做；0=从不
