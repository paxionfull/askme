{
  "$schema_comment": "Askme design tokens. Cool is commercial default. Warm is legacy archive only.",
  "meta": {
    "product": "Askme",
    "defaultTheme": "cool",
    "figmaVariableCollection": "Askme / Theme"
  },
  "themes": {
    "cool": {
      "color": {
        "paper": "#f4f5f7",
        "paperRaised": "#ffffff",
        "ink": "#0f172a",
        "inkMuted": "#64748b",
        "rule": "#e2e8f0",
        "accent": "#2563eb",
        "accentSoft": "#eff6ff",
        "focusWash": "#eff6ff",
        "link": "#334155",
        "success": "#15803d",
        "successSoft": "#f0fdf4",
        "warningSoft": "#fffbeb",
        "errorSoft": "#fef2f2",
        "danger": "#991b1b"
      },
      "radius": {
        "control": "0.5rem",
        "panel": "0.625rem"
      },
      "font": {
        "sans": "PingFang SC, Hiragino Sans GB, Noto Sans SC, Microsoft YaHei, system-ui, sans-serif"
      },
      "space": {
        "unit": 4,
        "scalePx": [4, 8, 12, 16, 20, 24, 32, 40, 48]
      }
    },
    "warm": {
      "comment": "Legacy cream + terracotta. Do not ship as commercial default.",
      "color": {
        "paper": "#f7f3ec",
        "paperRaised": "#fffcf7",
        "ink": "#1c1917",
        "inkMuted": "#78716c",
        "rule": "#e7e0d5",
        "accent": "#b45309",
        "accentSoft": "#fff7ed"
      }
    }
  },
  "cssVariableMap": {
    "paper": "--paper",
    "paperRaised": "--paper-raised",
    "ink": "--ink",
    "inkMuted": "--ink-muted",
    "rule": "--rule",
    "accent": "--accent",
    "accentSoft": "--accent-soft",
    "focusWash": "--focus-wash",
    "link": "--link",
    "success": "--success",
    "successSoft": "--success-soft",
    "warningSoft": "--warning-soft",
    "errorSoft": "--error-soft",
    "radiusControl": "--radius-control",
    "radiusPanel": "--radius-panel"
  }
}
